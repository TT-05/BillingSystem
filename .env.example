# Copy this file to .env.local. Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration > Config.
# apiKey and appId must be copied exactly from the registered Web App; they cannot be derived from the project ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bill9206.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bill9206
VITE_FIREBASE_APP_ID=
# Explicitly true uses ONLY the demo-settle local emulators (not bill9206).
VITE_USE_EMULATORS=false
# No OAuth client secret, service account, measurementId, storageBucket or messagingSenderId is needed.
